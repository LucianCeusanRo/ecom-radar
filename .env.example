# Copy to .env (never commit .env). All values below are placeholders.
ECOM_WA_GROUP_TEST=          # WhatsApp group JID for test runs, e.g. 1203...@g.us
ECOM_WA_GROUP_PROD=          # WhatsApp group JID for production runs
ECOM_STORE_NAME=My Store
SHOPIFY_SHOP=                # your-store.myshopify.com
SHOPIFY_ADMIN_STORE=         # store handle used in admin.shopify.com/store/<handle>
SHOPIFY_CLIENT_ID=
SHOPIFY_VENDOR=My Store
GEMINI_API_KEY=
ADS_MONITOR_DIR=             # optional, used by dashboard/build_data.py
ECOM_DASH_URL=http://127.0.0.1:8765/ecom
# File-based secrets (also git-ignored): shopify_client_secret.txt, discord_webhook.txt,
# meta_adlib_token.txt, gemini_api_key.txt
